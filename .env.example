# STACOS local environment. Copy to `.env` and adjust.
# `.env` is gitignored; this file is the documented contract.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database
#
# Two roles, on purpose (see scripts/install-dev-stack.ps1):
#   stacos_app       runtime role, NOSUPERUSER / NOBYPASSRLS, so Row-Level
#                    Security actually applies to it.
#   stacos_migrator  owns the schema and runs migrations.
#
# `tasks.ps1 migrate` swaps DATABASE_URL for DATABASE_MIGRATE_URL automatically.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://stacos_app:stacos_app_dev@localhost:5432/stacos
DATABASE_MIGRATE_URL=postgres://stacos_migrator:stacos_migrator_dev@localhost:5432/stacos
DATABASE_CONN_MAX_AGE=60

# Superuser password, used ONCE by scripts/install-dev-stack.ps1 to create the
# roles, database and extensions. Not read by the application. Remove it after
# bootstrap if you would rather not keep it on disk.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# Set to False only to debug an RLS problem. Never in prod.
STACOS_RLS_ENABLED=True

# ---------------------------------------------------------------------------
# Redis (Memurai on Windows)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# Email — mailpit in dev (SMTP 1025, web UI 8025)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=STACOS <no-reply@stacos.local>

# ---------------------------------------------------------------------------
# WhatsApp — the second verification channel, via Meta's Cloud API.
#
# `console` prints the message to the terminal, which is how the sign-up flow is
# exercised in development without a Business Account or a second device.
#
# For `meta`, note that business-initiated messages need templates pre-approved
# by Meta, and one-time passcodes must use the AUTHENTICATION category. Approval
# takes days to weeks — start it well before you need it.
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_COST_PER_MESSAGE=0.125

# OTP throttling and cost control. Verification messaging is a real expense and a
# real fraud vector, so the daily cap fails closed rather than degrading silently.
OTP_MAX_PER_IDENTITY_PER_HOUR=5
OTP_MAX_PER_IDENTITY_PER_DAY=10
OTP_MAX_PER_IP_PER_HOUR=20
OTP_CODE_TTL_SECONDS=600
OTP_PEPPER=dev-only-otp-pepper-change-me
WHATSAPP_DAILY_SPEND_CAP_UNITS=1000

# ---------------------------------------------------------------------------
# Trusted devices / step-up auth
# ---------------------------------------------------------------------------
TRUSTED_DEVICE_DAYS=30

# Re-prompting for the password before a sensitive action (approving a return,
# changing a role or payment method, granting or revoking an engagement).
#
# Off. Set it to True to bring the prompt back — that is the whole change; the
# views, decorators and tests behind it are all still in place. MAX_AGE is how
# long one confirmation stays fresh, and only applies when ENABLED is True.
STEP_UP_ENABLED=False
STEP_UP_MAX_AGE_SECONDS=600

# ---------------------------------------------------------------------------
# Social login (django-allauth). Blank disables the provider.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_SECRET=
APPLE_KEY_ID=
APPLE_TEAM_ID=

# ---------------------------------------------------------------------------
# Object storage. Dev uses the local filesystem; prod uses S3-compatible storage
# in an Indian region (DPDP Act data residency).
# ---------------------------------------------------------------------------
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=False
