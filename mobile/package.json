{
  "name": "stacos-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "STACOS mobile client. Framework7 + React, wrapped with Capacitor. Consumes the DRF API at /api/v1 — the only client in the system that speaks JSON.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "build": "vite build",
    "preview": "vite preview --port 3002",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "framework7": "^8.3.4",
    "framework7-react": "^8.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.4",
    "@capacitor/network": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
